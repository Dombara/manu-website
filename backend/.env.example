PORT=5000

# Email configuration (Gmail SMTP)
# For Gmail: use a Gmail address and an App Password (NOT your regular password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=YOUR_GMAIL_ADDRESS
EMAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Recipient address for quote and contact enquiries
MAIL_TO=production@manurobotics.com

# Sender address (should match EMAIL_USER for most SMTP providers)
MAIL_FROM=YOUR_SENDER_EMAIL

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
